# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.eggs/
*.egg

# Virtual environments
.venv/
venv/
env/

# pytest
.pytest_cache/
.coverage
htmlcov/

# macOS
.DS_Store

# IDE
.idea/
.vscode/

# Emacs temp / lock / backup files
*~
\#*\#
.\#*

# Cached gamemaster data (stored in ~/Documents, not here)
*.json.cache

# Claude Code local memory and per-user settings.
# .claude/settings.json is shared (committed); settings.local.json is personal.
.claude/*
!.claude/settings.json

# User-specific scratch / output (deep dive HTMLs, logs, ad-hoc data)
# See DEVELOPER_NOTES.md "Deep dive output file layout" for the convention
# on userdata/dives/ vs /tmp/ for HTML output files.
userdata/

# Worlds 2026 robustness planes: large regenerable sim blobs (a Tier-2
# plane is ~2.4MB packed-bool + ~38MB uint16 score per direction/bait).
# Only the npz blobs are ignored -- worlds/planes/manifest.json and
# worlds/meta.toml stay TRACKED as the provenance record.
/worlds/planes/*.npz

# In-session scratch grids (reproducible; findings live in DEVELOPER_NOTES.md).
# The oracle-grid expansion (2026-06-12) is regenerable via run_grid.py.
scratch_oracle_grid/

# Private launch-prep notes (Discord DMs, TestFlight link) -- never commit
/RedditPost.md
/scratch_thoughts.md
/reddit_posts_DRAFT.md
/docs/reddit_launch_plan.md
/docs/validations/2026-05_guide_reviews/hsh_review_response.md
/docs/validations/2026-05_guide_reviews/hsh_review_response_discord.md
/LAUNCH_STATUS.md
/REDDIT_SESSION_BRIEF.md
# JRE/RyanSwag published deep dives, used as local reference material
# while developing these tools. Kept local-only (not published) to
# avoid reproducing third-party copyrighted text.
/docs/reference_deep_dives/
# tier2 joint grids are heavier blobs; only tier2/manifest.json is tracked
/worlds/planes/tier2/*.npz
