#!/usr/bin/env bash
# Project pre-commit checks. Each reads the content being committed from the
# INDEX, not the working tree (step 2's live counts -- pytest collection, the
# type chart -- and the checker scripts themselves necessarily come from the
# working tree):
#   1. Reject authored_by = "ai" in ship-tracked TOMLs
#      (CLAUDE.md "Ship-mode narrative policy").
#   2. Verify DEVELOPER_NOTES.md dev-count sentinels against live code
#      (scripts/verify_dev_counts.py; only when an input is staged, incl.
#      a deleted test file). The
#      sentinel VALUES are read from the index; the live counts (pytest
#      collection, type chart) necessarily come from the working tree.
#   3. Verify DEVELOPER_NOTES.md stays under its read-whole size cap and
#      that its quoted section citations, repo paths and test refs resolve
#      (scripts/verify_dev_notes.py; every commit, incl. deletion-only).
#
# Install by running: git config core.hooksPath .githooks
# Escape hatch: git commit --no-verify. Rebase/cherry-pick/merge replays do
# not run pre-commit, so a replayed commit is unchecked until the next one.
set -euo pipefail

REPO_ROOT=$(git rev-parse --show-toplevel)

# Project interpreter. direnv puts .venv/bin on PATH in interactive shells
# and Emacs, but not in GUI git clients or non-interactive shells, and a
# `git worktree` checkout has no .venv of its own (gitignored). Try the
# checkout's venv, then the main worktree's, then PATH; a missing
# interpreter is reported as such, never as a check failure.
PY="$REPO_ROOT/.venv/bin/python"
if [[ ! -x "$PY" ]]; then
    PY="$(git rev-parse --path-format=absolute --git-common-dir)/../.venv/bin/python"
fi
if [[ ! -x "$PY" ]]; then
    PY=$(command -v python || true)
fi
if [[ -z "$PY" ]]; then
    echo 'ERROR: pre-commit: no project interpreter found: no .venv/bin/python in this' >&2
    echo '       checkout or the main worktree, and no python on PATH. In the main' >&2
    echo '       checkout run `uv venv && uv pip install -e ".[dev,perf]"`.' >&2
    exit 1
fi

# Export the index (only the paths the checker reads, ~0.1 s) into the git
# dir, which is always writable and per-worktree -- an odd TMPDIR from a
# GUI client must not block commits. `git commit <path>` hands the hook a
# temporary GIT_INDEX_FILE, which ls-files/checkout-index honour.
GIT_DIR_ABS=$(git rev-parse --absolute-git-dir)
# A hook killed by SIGKILL skips its EXIT trap; nothing else ever looks in
# .git, so sweep exports older than an hour here.
find "$GIT_DIR_ABS" -maxdepth 1 -name 'index-export.*' -mmin +60 -exec rm -rf {} + 2>/dev/null || true
INDEX_EXPORT=$(mktemp -d "$GIT_DIR_ABS/index-export.XXXXXX")
trap 'rm -rf "$INDEX_EXPORT"' EXIT
# shellcheck disable=SC2046  # the paths are the checker's constants, no spaces
git ls-files -z -- $("$PY" "$REPO_ROOT/scripts/verify_dev_notes.py" --print-scan-paths) \
    | git checkout-index -z --prefix="$INDEX_EXPORT/" --stdin

# --- 3. DEVELOPER_NOTES size cap + pointer integrity -----------------
# First and unconditional: it must also run for deletion/rename-only
# commits and for --amend with nothing staged, which the early exit below
# would skip. Exit 3 (DRIFT_EXIT) = drift; anything else = the checker
# itself crashed (1: traceback; 2: argparse usage error or missing script).
set +e
"$PY" "$REPO_ROOT/scripts/verify_dev_notes.py" --quiet --repo-root "$INDEX_EXPORT"
rc=$?
set -e
if [[ $rc -eq 3 ]]; then
    echo >&2
    echo 'Commit blocked by DEVELOPER_NOTES drift (size cap or dangling pointer)' >&2
    echo 'in the content being committed. Run scripts/verify_dev_notes.py for the' >&2
    echo 'full working-tree report; stage the fix, or use --no-verify.' >&2
    exit 1
elif [[ $rc -ne 0 ]]; then
    echo >&2
    echo "ERROR: scripts/verify_dev_notes.py crashed (exit $rc); this is a checker" >&2
    echo '       bug, not notes drift. Fix it or commit with --no-verify.' >&2
    exit 1
fi

# Paths unquoted (core.quotePath=false) so a non-ASCII TOML name still hits
# the `thresholds/*.toml` pattern. STAGED_ANY includes deletions, which can
# change the derived test count but cannot carry an authored_by line.
STAGED=$(git -c core.quotePath=false diff --cached --name-only --diff-filter=ACMR)
STAGED_ANY=$(git -c core.quotePath=false diff --cached --name-only)
if [[ -z "$STAGED_ANY" ]]; then
    exit 0
fi

# --- 1. Ship-mode narrative policy -----------------------------------

AI_FILES=""
while IFS= read -r f; do
    case "$f" in
        articles/*.toml|thresholds/*.toml)
            # No `grep -q`: under pipefail an early exit sends `git show`
            # SIGPIPE on a large blob and the file silently passes.
            if git show ":$f" | grep '^authored_by = "ai"' >/dev/null; then
                AI_FILES="$AI_FILES$f"$'\n'
            fi
            ;;
    esac
done <<< "$STAGED"

if [[ -n "$AI_FILES" ]]; then
    echo "ERROR: AI-drafted prose in ship-tracked TOMLs:" >&2
    printf '%s' "$AI_FILES" | sed 's/^/  /' >&2
    echo >&2
    echo 'Policy: articles/ and thresholds/ must not carry' >&2
    echo '  authored_by = "ai"' >&2
    echo 'Either blank the field and let scripts/auto_gen_narrative.py' >&2
    echo 'populate it at render time, or human-author and set' >&2
    echo '  authored_by = "human" or "mixed".' >&2
    echo 'See docs/auto_gen_narrative_plan.md and CLAUDE.md' >&2
    echo '"Ship-mode narrative policy" for the full rule.' >&2
    exit 1
fi

# --- 2. Dev-count sentinel drift -------------------------------------

# Only run when DEVELOPER_NOTES.md or any derivation input is staged (added,
# modified, renamed OR deleted -- a deleted test file changes the count):
# keeps the hook fast for unrelated commits. Derivation inputs are the
# type chart (src/gopvpsim/moves.py) and the test suite (tests/**).
needs_dev_count_check=0
while IFS= read -r f; do
    case "$f" in
        DEVELOPER_NOTES.md|src/gopvpsim/moves.py|tests/*|scripts/verify_dev_counts.py)
            needs_dev_count_check=1
            ;;
    esac
done <<< "$STAGED_ANY"

if [[ "$needs_dev_count_check" -eq 1 ]]; then
    set +e
    "$PY" "$REPO_ROOT/scripts/verify_dev_counts.py" --quiet \
        --notes "$INDEX_EXPORT/DEVELOPER_NOTES.md"
    rc=$?
    set -e
    if [[ $rc -eq 3 ]]; then
        echo >&2
        echo 'Commit blocked by dev-count drift (sentinel values read from the index).' >&2
        exit 1
    elif [[ $rc -ne 0 ]]; then
        echo >&2
        echo "ERROR: scripts/verify_dev_counts.py could not run (exit $rc): a script or" >&2
        echo '       environment problem (e.g. no pytest/certifi in the venv), not drift.' >&2
        exit 1
    fi
fi

exit 0
