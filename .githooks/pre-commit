#!/usr/bin/env bash
# Project pre-commit checks. Each reads the content being committed from the
# INDEX, not the working tree (step 2's live counts -- pytest collection, the
# type chart -- and the checker scripts themselves necessarily come from the
# working tree):
#   1. Reject a ship-tracked TOML with an authored_by whose value reads as
#      "ai" (.strip().lower(), as deep_dive_rendering._authored_by_class
#      does) in ANY table -- broader than the renderer, which reads only
#      intro/meta_role/verdict -- and any symlinked one (CLAUDE.md
#      "Ship-mode narrative policy").
#   2. Verify DEVELOPER_NOTES.md dev-count sentinels against live code
#      (scripts/verify_dev_counts.py; only when an input is staged, incl.
#      a deleted test file). The
#      sentinel VALUES are read from the index; the live counts (pytest
#      collection, type chart) necessarily come from the working tree.
#   3. Verify DEVELOPER_NOTES.md stays under its read-whole size cap and
#      that its quoted section citations, repo paths and test refs resolve
#      (scripts/verify_dev_notes.py; every commit, incl. deletion-only).
#
# Install by running: git config core.hooksPath .githooks
# Escape hatch: git commit --no-verify. Rebase (`rebase --continue` too),
# clean cherry-pick/revert replays and fast-forward merges/pulls never run
# pre-commit, so a commit that arrives that way is unchecked until the next
# one; a non-fast-forward clean merge runs pre-merge-commit instead, which
# is a symlink to this file; a conflict resolution finished with `git
# commit`, `merge --continue` or `cherry-pick --continue` runs it normally.
set -euo pipefail

REPO_ROOT=$(git rev-parse --show-toplevel)

# Project interpreter. direnv puts .venv/bin on PATH in interactive shells
# and Emacs, but not in GUI git clients or non-interactive shells, and a
# `git worktree` checkout has no .venv of its own (gitignored). Try the
# checkout's venv, then the main worktree's, then PATH; a missing
# interpreter is reported as such, never as a check failure.
PY="$REPO_ROOT/.venv/bin/python"
if [[ ! -x "$PY" ]]; then
    PY="$(git rev-parse --path-format=absolute --git-common-dir)/../.venv/bin/python"
fi
if [[ ! -x "$PY" ]]; then
    PY=$(command -v python || true)
fi
if [[ -z "$PY" ]]; then
    echo 'ERROR: pre-commit: no project interpreter found: no .venv/bin/python in this' >&2
    echo '       checkout or the main worktree, and no python on PATH. In the main' >&2
    echo '       checkout run `uv venv && uv pip install -e ".[dev,perf]"`.' >&2
    exit 1
fi

# Export the index (only the paths the checker reads, ~0.1 s) into the git
# dir, which is always writable and per-worktree -- an odd TMPDIR from a
# GUI client must not block commits. `git commit <path>` hands the hook a
# temporary GIT_INDEX_FILE, which ls-files/checkout-index honour.
GIT_DIR_ABS=$(git rev-parse --absolute-git-dir)
# A hook killed by SIGKILL skips its EXIT trap; nothing else ever looks in
# .git, so sweep exports older than an hour here.
find "$GIT_DIR_ABS" -maxdepth 1 -name 'index-export.*' -mmin +60 -exec rm -rf {} + 2>/dev/null || true
INDEX_EXPORT=$(mktemp -d "$GIT_DIR_ABS/index-export.XXXXXX")
trap 'rm -rf "$INDEX_EXPORT"' EXIT
# shellcheck disable=SC2046  # the paths are the checker's constants, no spaces
# --ignore-skip-worktree-bits: a sparse checkout (or any skip-worktree
# entry) otherwise makes checkout-index refuse and abort every commit.
git ls-files -z -- $("$PY" "$REPO_ROOT/scripts/verify_dev_notes.py" --print-scan-paths) \
    | git checkout-index -z --ignore-skip-worktree-bits --prefix="$INDEX_EXPORT/" --stdin

# --- 3. DEVELOPER_NOTES size cap + pointer integrity -----------------
# First and unconditional: it must also run for deletion/rename-only
# commits and for --amend with nothing staged, which the early exit below
# would skip. Exit 3 (DRIFT_EXIT) = drift; anything else = the checker
# itself crashed (1: traceback; 2: argparse usage error or missing script).
set +e
"$PY" "$REPO_ROOT/scripts/verify_dev_notes.py" --quiet --repo-root "$INDEX_EXPORT"
rc=$?
set -e
if [[ $rc -eq 3 ]]; then
    echo >&2
    echo 'Commit blocked by DEVELOPER_NOTES drift (size cap or dangling pointer)' >&2
    echo 'in the content being committed. Run scripts/verify_dev_notes.py for the' >&2
    echo 'full working-tree report; stage the fix, or use --no-verify.' >&2
    exit 1
elif [[ $rc -ne 0 ]]; then
    echo >&2
    echo "ERROR: scripts/verify_dev_notes.py crashed (exit $rc); this is a checker" >&2
    echo '       bug, not notes drift. Fix it or commit with --no-verify.' >&2
    exit 1
fi

# Staged names are read NUL-terminated (-z) straight from git: a text
# listing C-quotes a name holding `"`, `\`, a tab or a newline (quotePath
# covers only high bytes), and `"thresholds/zz\"q.toml"` matched no pattern,
# so such a file skipped steps 1 and 2. --no-renames lists a rename as D + A:
# with detection on, `git mv tests/x.py docs/` showed only the destination
# and step 2 never saw the test count change. Deletions are included for
# step 2 (they change the derived test count); T (typechange, e.g. a file
# replaced by a symlink) is checked by step 1 too.
staged_names() {  # $1: --diff-filter value, or "" for everything
    git diff --cached -z --no-renames --name-only ${1:+--diff-filter=$1}
}
if [[ -z "$(git diff --cached --no-renames --name-only)" ]]; then
    exit 0
fi

# --- 1. Ship-mode narrative policy -----------------------------------

# Value test as in scripts/deep_dive_rendering.py _authored_by_class
# (.strip().lower() == "ai"), applied to an authored_by in ANY table --
# deliberately broader than the renderer, which reads only the intro /
# meta_role / verdict blocks, so the field cannot dodge the gate by moving.
# `authored_by="ai"`, 'ai', "AI", an indented or dotted key and an inline
# table all count (a literal `^authored_by = "ai"` grep missed every one).
# A TOML that does not parse gets a tolerant line match instead, so a syntax
# error does not switch the check off (the renderer cannot load such a file
# anyway). Exit 0 = found, 3 = clean; anything else is a crash and BLOCKS
# (an uncaught exception also exits 1, which used to read as "clean").
# -I: ignore the cwd and the environment, so an untracked tomllib.py at the
# repo root cannot shadow the stdlib.
read -r -d '' AI_CHECK <<'PY' || true
import re, sys, tomllib
text = sys.stdin.buffer.read().decode('utf-8', 'replace')
def walk(o):
    if isinstance(o, dict):
        v = o.get('authored_by')
        return (isinstance(v, str) and v.strip().lower() == 'ai') or any(walk(x) for x in o.values())
    return isinstance(o, list) and any(walk(x) for x in o)
try:
    hit = walk(tomllib.loads(text))
except tomllib.TOMLDecodeError:
    hit = re.search(r'(?im)^\s*(?:[\w.-]+\.)?authored_by\s*=\s*["\']\s*ai\s*["\']', text) is not None
sys.exit(0 if hit else 3)
PY

AI_FILES=""
LINK_FILES=""
UNCHECKED=""
while IFS= read -r -d '' f; do
    case "$f" in
        articles/*.toml|thresholds/*.toml)
            # A staged symlink (index mode 120000) shows its target PATH to
            # `git show`, not the content, so it cannot be checked: reject.
            # :(literal) -- a name holding `[`, `*` or `?` is otherwise a glob
            # and ls-files can list ANOTHER file's mode.
            if [[ "$(git ls-files -s -- ":(literal)$f" | cut -c1-6)" == 120000 ]]; then
                LINK_FILES="$LINK_FILES$f"$'\n'
            else
                set +e
                git show ":$f" | "$PY" -I -c "$AI_CHECK"
                rc=$?
                set -e
                case $rc in
                    0) AI_FILES="$AI_FILES$f"$'\n' ;;
                    3) ;;
                    *) UNCHECKED="$UNCHECKED$f (exit $rc)"$'\n' ;;
                esac
            fi
            ;;
    esac
done < <(staged_names ACMT)

if [[ -n "$UNCHECKED" ]]; then
    echo "ERROR: could not check authored_by in ship-tracked TOMLs (a crash, not a" >&2
    echo "       policy verdict; see the traceback above):" >&2
    printf '%s' "$UNCHECKED" | sed 's/^/  /' >&2
    exit 1
fi

if [[ -n "$LINK_FILES" ]]; then
    echo "ERROR: symlinked ship-tracked TOMLs (content cannot be checked):" >&2
    printf '%s' "$LINK_FILES" | sed 's/^/  /' >&2
    exit 1
fi

if [[ -n "$AI_FILES" ]]; then
    echo "ERROR: AI-drafted prose in ship-tracked TOMLs:" >&2
    printf '%s' "$AI_FILES" | sed 's/^/  /' >&2
    echo >&2
    echo 'Policy: articles/ and thresholds/ must not carry an authored_by' >&2
    echo '  the renderer reads as "ai" (any table, quoting or case).' >&2
    echo 'Either blank the field and let scripts/auto_gen_narrative.py' >&2
    echo 'populate it at render time, or human-author and set' >&2
    echo '  authored_by = "human" or "mixed".' >&2
    echo 'See docs/auto_gen_narrative_plan.md and CLAUDE.md' >&2
    echo '"Ship-mode narrative policy" for the full rule.' >&2
    exit 1
fi

# --- 2. Dev-count sentinel drift -------------------------------------

# Only run when DEVELOPER_NOTES.md or any derivation input is staged (added,
# modified OR deleted -- a deleted test file changes the count, and a rename
# out of tests/ is listed as its D side): keeps the hook fast for unrelated
# commits. Derivation inputs are the type chart (src/gopvpsim/moves.py) and
# the test suite (tests/**). Collection also depends on data.py and
# pyproject.toml's pytest config; those are not triggers, so a commit that
# changes only them is checked by the next commit that touches tests/.
needs_dev_count_check=0
while IFS= read -r -d '' f; do
    case "$f" in
        DEVELOPER_NOTES.md|src/gopvpsim/moves.py|tests/*|scripts/verify_dev_counts.py)
            needs_dev_count_check=1
            ;;
    esac
done < <(staged_names "")

if [[ "$needs_dev_count_check" -eq 1 ]]; then
    set +e
    "$PY" "$REPO_ROOT/scripts/verify_dev_counts.py" --quiet \
        --notes "$INDEX_EXPORT/DEVELOPER_NOTES.md"
    rc=$?
    set -e
    if [[ $rc -eq 3 ]]; then
        echo >&2
        echo 'Commit blocked by dev-count drift (sentinel values read from the index).' >&2
        exit 1
    elif [[ $rc -ne 0 ]]; then
        echo >&2
        echo "ERROR: scripts/verify_dev_counts.py could not run (exit $rc): a script or" >&2
        echo '       environment problem (e.g. no pytest/certifi in the venv), not drift.' >&2
        exit 1
    fi
fi

exit 0
